# Container image
SKYFIRE_SERVER_IMAGE=localhost/dr1s/skyfire548-server:latest
SKYFIRE_DBINIT_IMAGE=localhost/dr1s/skyfire548-db-init:latest

# Database connection settings
DB_HOST=db
DB_PORT=3306
DB_USER=skyfire
DB_PASSWORD=skyfire
DB_ROOT_PASSWORD=skyfire

# Optional: update the realmlist address when the worldserver IP changes
# WORLD_IP=192.168.1.10

# Optional: update the realmlist name
# WORLD_NAME=My Realm

# Optional volume names/paths
# DB_DATA_VOL=dbdata
# CLIENT_DATA_VOL=./data
