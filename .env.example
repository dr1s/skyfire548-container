# Container image
SKYFIRE_SERVER_IMAGE=localhost/dr1s/skyfire548-server:latest
SKYFIRE_DBINIT_IMAGE=localhost/dr1s/skyfire548-db-init:latest

# Database service credentials (mysql:8.4 container)
MYSQL_USER=skyfire
MYSQL_PASSWORD=skyfire
MYSQL_ROOT_PASSWORD=skyfire

# Application database connection settings
DB_HOST=db
DB_PORT=3306
DB_USER=skyfire
DB_PASSWORD=skyfire
DB_ROOT_PASSWORD=skyfire

# Optional volume names/paths
# DB_DATA_VOL=dbdata
# CLIENT_DATA_VOL=./data
